# ─────────────────────────────────────────────────────────────
# Admin Panel - Environment Variables Example
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit real secrets to the repository.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8082
NODE_ENV=development

# ── Supabase (use anon key only, NEVER service_role in frontend) ─
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend API ──────────────────────────────────────────────
API_BASE_URL=http://localhost:8080/api
ADMIN_API_BASE_URL=http://localhost:8080/api/admin

# ── Authentication ───────────────────────────────────────────
# JWT_SECRET should ONLY be set in backend environment, not here.
# NEVER expose JWT_SECRET or service_role keys in frontend env.

# ── Feature Flags ────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_IMPERSONATION=true
NEXT_PUBLIC_ENABLE_BULK_EXPORT=true
NEXT_PUBLIC_ENABLE_CSV_IMPORT=true
