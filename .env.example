# ─────────────────────────────────────────────────────────────
# Admin Panel - Environment Variables Example
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit real secrets to the repository.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8082
# Note: client-side uses /api (relative). NEXT_PUBLIC_API_URL is the BACKEND origin
# (no /api suffix). The internal config strips trailing /api if present.
NODE_ENV=development

# ── Backend API ──────────────────────────────────────────────
# Server-only backend origin used by Next.js middleware/routes (Go API on :8082).
# Production deployments must use HTTPS.
INTERNAL_API_URL=http://127.0.0.1:8082

# ── Authentication ───────────────────────────────────────────
# Server-only secret used by Next.js middleware to verify backend-issued JWTs.
# It must match the backend JWT secret and be at least 32 random characters.
# NEVER prefix it with NEXT_PUBLIC_ or expose it to browser code.
#
# ⚠️ MUST BE REPLACED — generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this placeholder is copied as-is, the middleware FAILS CLOSED:
# all /admin and /api/admin requests will be rejected until it is set.
JWT_SECRET=__CHANGE_ME__openssl-rand-hex-32__CHANGE_ME__

# ── Feature Flags ────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_IMPERSONATION=true
NEXT_PUBLIC_ENABLE_BULK_EXPORT=true
NEXT_PUBLIC_ENABLE_CSV_IMPORT=true

# ── Docker Compose (local only) ───────────────────────────────
# Required by docker-compose.yml. Use unique random values; never commit them.
# NOTE: Frontend/Admin does NOT connect to database directly.
# These variables are ONLY for docker-compose.yml to configure the database service.
POSTGRES_PASSWORD=__CHANGE_ME__local-db-password__CHANGE_ME__
IMPERSONATION_SECRET=__CHANGE_ME__openssl-rand-hex-32__CHANGE_ME__
DEFAULT_ADMIN_PASSWORD=__CHANGE_ME__strong-admin-password__CHANGE_ME__

# ── External Alerting (optional) ──────────────────────────────
# Webhook URL (Slack/Discord/Grafana/… ) notified when the app fails
# to initialize at startup (see src/instrumentation.ts). Leave empty to disable.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Redis (local development) ──────────────────────────────────
# Local Redis for development (used by BullMQ queues and CacheService)
REDIS_URL=redis://localhost:6379
DISABLE_REDIS="false"
