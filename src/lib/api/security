    LOGOUT: "تسجيل خروج",
    REGISTER: "تسجيل حساب جديد",
    PASSWORD_CHANGE: "تغيير كلمة المرور",
    MAGIC_LINK_REQUESTED: "طلب رابط سحري",
    MAGIC_LINK_LOGIN: "دخول بالرابط السحري",
    "2FA_ENABLED": "تفعيل التحقق الثنائي",
    "2FA_DISABLED": "تعطيل التحقق الثنائي",
    "2FA_FAILED": "فشل التحقق الثنائي",
    EMAIL_VERIFIED: "توثيق البريد الإلكتروني",
    PASSWORD_RESET_REQUESTED: "طلب إعادة تعيين كلمة المرور",
    PASSWORD_RESET_SUCCESS: "إعادة تعيين كلمة المرور",
