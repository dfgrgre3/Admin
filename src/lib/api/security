export function getEventTypeColor(eventType: string): string {
  if (eventType.includes("SUCCESS") || eventType.includes("VERIFIED") || eventType === "LOGOUT") {
    return "bg-emerald-500/10 text-emerald-500 border-emerald-500/20";
  }
  if (eventType.includes("FAILED") || eventType.includes("SUSPICIOUS")) {
    return "bg-red-500/10 text-red-500 border-red-500/20";
  }
  if (eventType.includes("2FA")) {
    return "bg-blue-500/10 text-blue-500 border-blue-500/20";
  }
  if (eventType.includes("PASSWORD") || eventType.includes("MAGIC")) {
    return "bg-amber-500/10 text-amber-500 border-amber-500/20";
  }
  return "bg-slate-500/10 text-slate-500 border-slate-500/20";
}

