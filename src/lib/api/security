import { adminApi } from "./admin-api";
import { API_ROUTES } from "./security-routes";

// ─────────────────────────────────────────────
// Types
// ─────────────────────────────────────────────

export interface SecuritySession {
  id: string;
  userId: string;
  userAgent: string;
  ip: string;
  ipAddress?: string;
  location?: string | null;
  browser?: string;
  os?: string;
  country?: string;
  device?: string | null;
  deviceType?: string;
  rememberMe?: boolean;
  status: string;
  isActive: boolean;
  lastActive?: string;
  lastAccessed?: string;
  expiresAt?: string;
  absoluteExpiresAt?: string;
  revokedAt?: string | null;
  createdAt?: string;
  updatedAt?: string;
}

export interface SessionStats {
  totalActive: number;
  totalExpired: number;
  uniqueDevices: number;
}

export interface SecurityLogEntry {
  id: string;
  eventType: string;
  userId?: string | null;
  user?: { name: string; email: string } | null;
  ip: string;
  userAgent?: string;
  location?: string | null;
  metadata?: string | null;
  createdAt: string;
}

export interface DeviceFingerprint {
  id: string;
  userId: string;
  userName: string;
  fingerprint: string;
  ip: string;
  userAgent: string;
  deviceType: string;
  lastSeen?: string;
  isBlocked: boolean;
  blockReason?: string | null;
  loginCount: number;
}

export interface IPWhitelistEntry {
  id: string;
  ipAddress: string;
  cidr?: string;
  description?: string;
  type: "admin" | "api" | "webhook";
  status: "active" | "disabled";
  isTemporary: boolean;
  expiresAt?: string | null;
  lastUsedAt?: string | null;
  createdBy: string;
  createdAt: string;
  country?: string;
  city?: string;
}

export interface IPWhitelistSettings {
  isEnabled: boolean;
  enforceForAdmins: boolean;
  enforceForAPI: boolean;
  defaultAction: "allow" | "deny";
  allowInternalIPs: boolean;
  internalIPRanges: string[];
  logBlockedAttempts: boolean;
  notifyOnViolation: boolean;
  notifyEmail?: string;
}

export interface BlockedIPAttempt {
  id: string;
  ipAddress: string;
  endpoint: string;
  method: string;
  userAgent?: string;
  location?: string;
  reason: string;
  userId?: string;
  count: number;
  attemptedAt: string;
}

export interface RolePermissionInfo {
  id: string;
  name: string;
  description: string;
  permissions: string[];
  userCount: number;
}

export interface SessionActivityEntry {
  id: string;
  userId: string;
  userAgent?: string;
  ip: string;
  browser?: string;
  os?: string;
  deviceType?: string;
  status?: string;
  isActive?: boolean;
  lastAccessed?: string;
  createdAt?: string;
  updatedAt: string;
}

// Response envelopes (backend uses api_response.Success → { data: ... } or flat objects)
interface JsonRecord {
  [key: string]: unknown;
}

interface SessionsResponse {
  sessions?: SecuritySession[];
  data?: SessionsResponse;
}

interface SessionStatsResponse {
  totalActive?: number;
  totalExpired?: number;
  uniqueDevices?: number;
  data?: SessionStatsResponse;
}

interface ActivityResponse {
  activity?: SessionActivityEntry[];
  data?: ActivityResponse;
}

interface LogsResponse {
  logs?: SecurityLogEntry[];
  data?: LogsResponse;
}

interface DevicesResponse {
  devices?: DeviceFingerprint[];
  data?: DevicesResponse;
}

interface WhitelistResponse {
  entries?: IPWhitelistEntry[];
  data?: WhitelistResponse;
}

interface WhitelistSettingsResponse {
  isEnabled?: boolean;
  enforceForAdmins?: boolean;
  enforceForAPI?: boolean;
  defaultAction?: string;
  allowInternalIPs?: boolean;
  internalIPRanges?: string[];
  logBlockedAttempts?: boolean;
  notifyOnViolation?: boolean;
  notifyEmail?: string;
  data?: WhitelistSettingsResponse;
}

interface BlockedAttemptsResponse {
  attempts?: BlockedIPAttempt[];
  data?: BlockedAttemptsResponse;
}

interface RolesResponse {
  roles?: RolePermissionInfo[];
  data?: RolesResponse;
}

interface RevokeResponse extends JsonRecord {
  revokedCount?: number;
  data?: RevokeResponse;
}

// ─────────────────────────────────────────────
// API Functions
// ─────────────────────────────────────────────

export const securityApi = {
  // ── Sessions ──
  getSessions: async (): Promise<SecuritySession[]> => {
    const data = await adminApi.get<SessionsResponse>(API_ROUTES.security.sessions);
    return data?.data?.sessions || data?.sessions || [];
  },

  getSessionStats: async (): Promise<SessionStats> => {
    const data = await adminApi.get<SessionStatsResponse>(API_ROUTES.security.sessionStats);
    const stats = data?.data || data || {};
    return {
      totalActive: stats.totalActive || 0,
      totalExpired: stats.totalExpired || 0,
      uniqueDevices: stats.uniqueDevices || 0,
    };
  },

  getSessionActivity: async (limit = 100): Promise<SessionActivityEntry[]> => {
    const data = await adminApi.get<ActivityResponse>(
      `${API_ROUTES.security.sessionActivity}?limit=${limit}`
    );
    return data?.data?.activity || data?.activity || [];
  },

  revokeSession: async (sessionId: string): Promise<void> => {
    await adminApi.post<{ message?: string }>(API_ROUTES.security.revokeSession(sessionId), {});
  },

  suspendSession: async (sessionId: string): Promise<void> => {
    await adminApi.post<{ message?: string }>(API_ROUTES.security.suspendSession(sessionId), {});
  },

  revokeUserSessions: async (userId: string): Promise<{ revokedCount: number }> => {
    const data = await adminApi.post<RevokeResponse>(
      API_ROUTES.security.revokeUserSessions(userId),
      {}
    );
    return {
      revokedCount:
        data?.data?.revokedCount || data?.revokedCount || 0,
    };
  },

  // ── Security Logs ──
  getSecurityLogs: async (limit = 100): Promise<SecurityLogEntry[]> => {
    const data = await adminApi.get<LogsResponse>(`${API_ROUTES.security.logs}?limit=${limit}`);
    return data?.data?.logs || data?.logs || [];
  },

  getSecurityLogsForUser: async (userId: string, limit = 50): Promise<SecurityLogEntry[]> => {
    const data = await adminApi.get<LogsResponse>(
      `${API_ROUTES.security.userLogs(userId)}?limit=${limit}`
    );
    return data?.data?.logs || data?.logs || [];
  },

  // ── Device Fingerprints ──
  getDeviceFingerprints: async (): Promise<DeviceFingerprint[]> => {
    const data = await adminApi.get<DevicesResponse>(API_ROUTES.security.fingerprints);
    return data?.data?.devices || data?.devices || [];
  },

  blockDevice: async (fingerprintId: string, reason?: string): Promise<void> => {
    await adminApi.post<{ message?: string }>(API_ROUTES.security.blockFingerprint, {
      fingerprintId,
      reason,
    });
  },

  unblockDevice: async (fingerprintId: string): Promise<void> => {
    await adminApi.post<{ message?: string }>(API_ROUTES.security.unblockFingerprint(fingerprintId), {});
  },

  // ── IP Whitelist ──
  getIPWhitelist: async (): Promise<IPWhitelistEntry[]> => {
    const data = await adminApi.get<WhitelistResponse>(API_ROUTES.security.ipWhitelist);
    return data?.data?.entries || data?.entries || [];
  },

  addIPToWhitelist: async (entry: {
    ipAddress: string;
    cidr?: string;
    description?: string;
    type: "admin" | "api" | "webhook";
    expiresAt?: string;
  }): Promise<void> => {
    await adminApi.post<{ message?: string }>(API_ROUTES.security.ipWhitelist, entry);
  },

  removeIPFromWhitelist: async (id: string): Promise<void> => {
    await adminApi.delete<{ message?: string }>(API_ROUTES.security.ipWhitelistById(id));
  },

  updateIPWhitelistEntry: async (
    id: string,
    updates: { description?: string; status?: string }
  ): Promise<void> => {
    await adminApi.patch<{ message?: string }>(API_ROUTES.security.ipWhitelistById(id), updates);
  },

  getIPWhitelistSettings: async (): Promise<IPWhitelistSettings> => {
    const data = await adminApi.get<WhitelistSettingsResponse>(API_ROUTES.security.ipWhitelistSettings);
    const s = data?.data || data || {};
    return {
      isEnabled: Boolean(s.isEnabled),
      enforceForAdmins: Boolean(s.enforceForAdmins),
      enforceForAPI: Boolean(s.enforceForAPI),
      defaultAction: (s.defaultAction as "allow" | "deny") || "allow",
      allowInternalIPs: Boolean(s.allowInternalIPs),
      internalIPRanges: (s.internalIPRanges as string[]) || [],
      logBlockedAttempts: Boolean(s.logBlockedAttempts),
      notifyOnViolation: Boolean(s.notifyOnViolation),
      notifyEmail: s.notifyEmail,
    };
  },

  updateIPWhitelistSettings: async (settings: Partial<IPWhitelistSettings>): Promise<void> => {
    await adminApi.post<{ message?: string }>(API_ROUTES.security.ipWhitelistSettings, settings);
  },

  getBlockedAttempts: async (): Promise<BlockedIPAttempt[]> => {
    const data = await adminApi.get<BlockedAttemptsResponse>(API_ROUTES.security.ipWhitelistBlocked);
    return data?.data?.attempts || data?.attempts || [];
  },

  // ── Roles ──
  getRolePermissions: async (): Promise<RolePermissionInfo[]> => {
    const data = await adminApi.get<RolesResponse>(API_ROUTES.security.roles);
    return data?.data?.roles || data?.roles || [];
  },
};

